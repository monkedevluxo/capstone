# SentinelAI · Variables de entorno
#
# Copia este archivo como .env en la raíz del repositorio y ajusta los valores:
#   cp .env.ejemplo .env
# El .env no se versiona (está en .gitignore). Nunca subas credenciales reales.
#
# Docker Compose lee este archivo al levantar los servicios. Detalle en
# docs/guias/MANUAL_TECNICO.md, sección "Configuración".

# Dirección de Ollama, vista desde el contenedor de la API.
# - Ollama en el mismo equipo con Docker Desktop: http://host.docker.internal:11434
# - Ollama en el mismo equipo con Docker Engine en WSL2: la IP del host, que da
#   `ip route show | grep default | awk '{print $3}'` (cambia al reiniciar WSL)
# - Ollama en otro equipo: http://<ip-del-equipo>:11434
OLLAMA_URL=http://host.docker.internal:11434

# true imprime cada consulta SQL en los logs de la API. Solo para depurar.
SQL_ECHO=false
