meta {
  name: Enriquecer un hallazgo
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/findings/{{findingId}}/enrich
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.ia.estado: eq ok
  res.body.vigente: eq true
  res.body.ia.id: isString
}

script:post-response {
  bru.setVar("sugerenciaVieja", res.getBody().ia.id);
}

docs {
  503 si no hay Ollama: levanta el falso (ver README).
}
