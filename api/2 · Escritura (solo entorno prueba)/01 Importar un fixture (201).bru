meta {
  name: Importar un fixture (201)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/scans/import
  body: file
  auth: none
}

body:file {
  file: @file(../lab/fixtures/zap_juiceshop_baseline_v1.json) @contentType(application/json)
}

assert {
  res.status: eq 201
  res.body.scan_id: isString
  res.body.nuevos: gt 0
  res.body.objetivo: eq http://juiceshop:3000
}

script:post-response {
  bru.setVar("scanId", res.getBody().scan_id);
}

docs {
  Importa lab/fixtures/zap_juiceshop_baseline_v1.json. Necesita que ese reporte no esté ya en la base.
}
